{
  "name": "ts-consent-flows",
  "version": "1.0.0",
  "private": true,
  "description": "Sandbox for testing and troubleshooting Didomi Consent Flows",
  "scripts": {
    "start": "python3 -m http.server 4173 --bind 127.0.0.1",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test tests/flows-state.test.mjs tests/flows-checks.test.mjs",
    "test:browser": "playwright test",
    "prettier": "prettier --write ."
  },
  "author": "Eric Murriguez",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "prettier": "^3.5.3"
  }
}
